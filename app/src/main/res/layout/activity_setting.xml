<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:padding="24dp"
    android:fillViewport="true"
    tools:context=".SettingActivity">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingBottom="32dp"
        android:gravity="center_horizontal">

        <!-- Heading -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="48dp" />

        <!-- Clear History Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_delete_task_history"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="See Completed Task"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="16dp"
            app:elevation="6dp"
            app:icon="@drawable/note"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <!-- Recover Data Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_recovery_data"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Recover Your Data"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:backgroundTint="?attr/colorSecondary"
            app:cornerRadius="16dp"
            app:elevation="6dp"
            app:icon="@drawable/recovery"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <!-- Clear History Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_delete_history"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Clear History"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:backgroundTint="?attr/colorError"
            app:cornerRadius="16dp"
            app:elevation="6dp"
            app:icon="@drawable/history"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <!-- Delete Account Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_delete_account"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Delete Account"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:backgroundTint="@android:color/holo_red_dark"
            app:cornerRadius="16dp"
            app:elevation="6dp"
            app:icon="@drawable/delete_user"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <!-- About App Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_About_App"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About This App"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:backgroundTint="?attr/colorSecondaryVariant"
            app:cornerRadius="16dp"
            app:elevation="6dp"
            app:icon="@drawable/info"
            app:iconGravity="textStart"
            app:iconPadding="12dp" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="32dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            style="?android:attr/progressBarStyleLarge" />

    </LinearLayout>
</ScrollView>
